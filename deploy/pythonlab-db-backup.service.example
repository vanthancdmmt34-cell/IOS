[Unit]
Description=PythonLab SQLite verified backup
After=network.target

[Service]
Type=oneshot
User=pythonlab
Group=pythonlab
WorkingDirectory=/opt/pythonlab
EnvironmentFile=/opt/pythonlab/.env
ExecStart=/usr/bin/node /opt/pythonlab/tools/db-maintenance.js backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pythonlab/data
