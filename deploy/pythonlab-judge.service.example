[Unit]
Description=PythonLab Judge Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=pythonlab
Group=pythonlab
WorkingDirectory=/opt/pythonlab/app
EnvironmentFile=/etc/pythonlab/judge.env
ExecStart=/usr/bin/node /opt/pythonlab/app/judge-service.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pythonlab
TimeoutStopSec=65
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
